                        observed.clear()
                        continue
                    fut = futures[msg["call_id"]]
                    if fut.done():
                        pass  # the run was stopped (restart) and its call cancelled
                    elif msg.get("ok"):
                        fut.set_result(msg.get("response"))
                    else:
