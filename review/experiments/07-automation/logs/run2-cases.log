                   client=None) -> None:
        sc = yaml.safe_load(path.read_text())
        if not sc.get("differential", True):
            pytest.skip(sc.get("differential_reason", "engine-only scenario"))
    
        await hass.config.async_set_time_zone("UTC")
        loc = sc.get("location", LOCATION)
