        for st in sc["steps"]:
            target = T0_DT + timedelta(seconds=st["at"])
            # advance one second at a time, like the bridge's ticks
            while current + timedelta(seconds=1) <= target:
                current += timedelta(seconds=1)
                freezer.move_to(current)
