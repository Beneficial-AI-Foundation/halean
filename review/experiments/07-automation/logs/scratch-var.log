            _h = _H(level=logging.WARNING)
            logging.getLogger().addHandler(_h)
        input_ctx = Context()
    
        async def handler(call: ServiceCall) -> None:
            observed.append(("call_service", call.domain, call.service, _norm_data(dict(call.data))))
