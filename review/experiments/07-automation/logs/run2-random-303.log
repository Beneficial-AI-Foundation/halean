                "engine_other": [[c for c in cs if c["type"] not in ("automation_triggered", "call_service", "fire_event")]
                                 for cs in raw_engine]}, default=str, indent=1))
        labels = ["init"] + [f"step at={s['at']}" for s in sc["steps"]]
        diffs = [
