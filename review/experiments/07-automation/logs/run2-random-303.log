                            else vol.Invalid("invalid") if kind == "invalid"
                            else RuntimeError("other"))
            await _settle()
            per_step.append(list(observed))
            observed.clear()
    
        # release anything still blocked so HA can shut down cleanly
        for fut in futures:
            if not fut.done():
                fut.set_result(None)
        await _settle()
    
