                if msg["type"] == "event":
                    hass.bus.async_fire(msg["event_type"], msg.get("data", {}), context=input_ctx)
                elif msg["type"] == "mqtt":
                    async_fire_mqtt_message(hass, msg["topic"], msg.get("payload", ""),
