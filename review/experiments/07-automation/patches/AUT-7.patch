+/-- An optional `cv.boolean` key. -/
+def cvBooleanKey (j : Json) (k : String) (dflt : Bool) : D Bool :=
+  match field? j k with
+  | none => pure dflt
+  | some (.bool b) => pure b
+  | some (.num n) => pure (n.mantissa != 0)
+  | some (.str s) => match Template.cvBooleanText s with
+    | some b => pure b
+    | none => throw s!"invalid boolean value {s} for '{k}'"
+  | some v => throw s!"invalid boolean value {v.compress} for '{k}'"
