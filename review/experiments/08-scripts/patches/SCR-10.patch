 def cvString (what : String) : Json → D String
   | .str s => pure s
   | .num n => pure (toString n)
+  -- `str(True)` / `str(False)`
+  | .bool b => pure (if b then "True" else "False")
   | v => throw s!"{what}: expected a string, got {v.compress}"
 
+/-- `cv.boolean`: a bool, a number (`!= 0`), or one of the strings HA
+accepts (any case, stripped). -/
+def cvBoolean (what : String) : Json → D Bool
+  | .bool b => pure b
+  | .num n => pure (n.mantissa != 0)
+  | .str s =>
+    let v := s.toLower.trim
+    if ["1", "true", "yes", "on", "enable"].contains v then pure true
+    else if ["0", "false", "no", "off", "disable"].contains v then pure false
+    else throw s!"{what}: invalid boolean value {s}"
+  | v => throw s!"{what}: invalid boolean value {v.compress}"
+
 /-- `cv.slug`: the object id must be its own slug. -/
 def isSlug (s : String) : Bool := !s.isEmpty && slugify? s == some s
 
