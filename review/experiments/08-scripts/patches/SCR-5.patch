diff --git a/HALean/Automation/Engine.lean b/HALean/Automation/Engine.lean
index bc6de0f..71785ce 100644
--- a/HALean/Automation/Engine.lean
+++ b/HALean/Automation/Engine.lean
@@ -849,6 +849,10 @@ def startScriptH (h : Handlers) (ai : Nat) (runVars : List (String × Template.V
     let e ← getE
     setE { e with starting := e.starting ++ [run.id] }
     for old in existing do h.stopRun old.id false
+    -- `await self.async_stop(...)` yields: whoever awaited a stopped run goes
