{"id": "T7", "readme_line": 246, "template": "{% for x in [1,2,3,4] if x != 2 %}{% if x == 4 %}{% break %}{% endif %}{{ loop.index }}:{{ x }} {% else %}none{% endfor %}", "expect": "same", "holds": true, "ha": {"ok": true, "type": "str", "repr": "'1:1 2:3'"}, "halean": {"ok": true, "repr": "'1:1 2:3'", "type": "str"}}
