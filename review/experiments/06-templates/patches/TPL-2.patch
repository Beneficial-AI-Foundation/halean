+/-- Whether Python can hash the literal (a dict key or a set element). -/
+partial def litHashable : Value → Bool
+  | .list _ | .dict _ => false
+  | .tuple xs => xs.all litHashable
+  | _ => true
+
+/-- A dict literal: a later equal key replaces the value of the first; an unhashable key is a `TypeError`. -/
+def litDict (kvs : List (Value × Value)) : Option Value :=
+  if kvs.all (fun (k, _) => litHashable k) then
+    some (.dict (kvs.foldl (fun (out : List (Value × Value)) (k, v) =>
+      if out.any (fun (k', _) => pyEq k' k) then out.map (fun (k', v') => if pyEq k' k then (k', v) else (k', v'))
+      else out ++ [(k, v)]) []))
+  else none
+
