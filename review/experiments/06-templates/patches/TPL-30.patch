+/-- The longest prefix matching `(_?d)*` for the digit class `isD`. -/
+def radixRun (isD : Char → Bool) : List Char → List Char
+  | '_' :: d :: rest => if isD d then '_' :: d :: radixRun isD rest else []
+  | d :: rest => if isD d then d :: radixRun isD rest else []
+  | [] => []
+
+/-- The longest prefix matching `\\d(_?\\d)*`. -/
+def numRun : List Char → List Char
+  | d :: rest => if d.isDigit then d :: radixRun Char.isDigit rest else []
+  | [] => []
+
