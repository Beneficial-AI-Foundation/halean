+/-- `bool(x)` during a render: `states` and `states.<domain>` have `__len__`, which also
+records the lifecycle listener. -/
+def truthyR (ctx : Ctx) (v : Value) : R Bool :=
+  match v with
+  | .domain _ | .allStates => do pure ((← lenV ctx v) != 0)
+  | v => pure (truthy v)
+
+/-- A value only its truth is asked of (`iif`). -/
+def boolProxy (ctx : Ctx) (v : Value) : R Value :=
+  match v with
+  | .domain _ | .allStates => do pure (.bool (← truthyR ctx v))
+  | v => pure v
+
