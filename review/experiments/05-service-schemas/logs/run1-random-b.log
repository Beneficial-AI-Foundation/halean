                    elif op["op"] == "call":
                        counts["same"] = counts.get("same", 0) + 1
                    if op["op"] == "register":
                        schema_of[(op["domain"], op["service"])] = op.get("schema")
                    continue
                assert lean == ha, f"op {i}: {op}\n  HA:     {ha}\n  HALean: {lean}"
