        counts: dict = {}
    
        def on_event(event) -> None:
            if event.event_type in EVENTS:
                fired.append(event)
    
        for et in EVENTS:
            hass.bus.async_listen(et, on_event)
        records = _Records()
        core_logger = logging.getLogger("homeassistant.core")
        core_logger.addHandler(records)
