                    result = await run_ha(hass, op, baseline)
                    ha: dict = {"ok": True, "result": result}
                except Exception as err:  # noqa: BLE001
                    ha = {"ok": False, "error": error_dict(err)}
                await hass.async_block_till_done()
                ha["events"] = [
