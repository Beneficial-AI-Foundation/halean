                if op.get("unsupported"):
                    assert "unsupported" in lean, f"op {i}: HALean should reject {op}, got {lean}"
                    continue
                if not RECORD:
                    assert "unsupported" not in lean, f"op {i}: HALean rejected {op}: {lean}"
                assert op.get("domain", "x").lower() not in baseline
    
