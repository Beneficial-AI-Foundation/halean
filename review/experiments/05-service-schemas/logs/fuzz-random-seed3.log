  data {"a": 123456.789, "days": {"hours": }, "effects": true, "myde": 1e+16}
  HA   ('err', 'OverflowError', 'int too large to convert to float')
  Lean ('err', 'MultipleInvalid', "expected float at 'days.hours'")

