                     "context": {"id": _fresh(e.context.id), "user_id": e.context.user_id,
                                 "parent_id": e.context.parent_id}}
                    for e in fired]
                ha["logs"] = [_log_dict(r) for r in records.records]
                if RECORD:
                    if lean != ha:
