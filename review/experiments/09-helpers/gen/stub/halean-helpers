#!/usr/bin/env python3
"""Proxy engine used only to learn HA's result where halean-helpers refuses.
It forwards every request to the real halean-helpers; when the real engine
answers {"unsupported": ...} it answers an empty result instead
({"outs": [], "logs": [], "states": [], "refused": reason}), so the harness goes on,
runs HA, and its assertion message prints HA's result for that step.
Use: HALEAN_BIN=gen/stub pytest harness/test_helpers.py -k <case>
The verdicts of such a run are not HALean verdicts."""
import json, os, subprocess, sys
real = os.environ.get("HALEAN_REAL_BIN", "/home/user/halean/.lake/build/bin") + "/halean-helpers"
p = subprocess.Popen([real], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
for line in sys.stdin:
    p.stdin.write(line); p.stdin.flush()
    out = p.stdout.readline()
    r = json.loads(out)
    if "unsupported" in r and json.loads(line).get("op") != "reset":
        out = json.dumps({"outs": [], "logs": [], "states": [], "refused": r["unsupported"]}) + "\n"
    sys.stdout.write(out); sys.stdout.flush()
